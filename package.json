{
  "name": "argus",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Microsoft 365 admin notification system",
  "scripts": {
    "dev": "bun --bun next dev --webpack -p ${PORT:-8100}",
    "dev:isolated": "ARGUS_ENV=dev PORT=8101 ARGUS_DB_PATH=./data/argus-dev.db bun run dev",
    "build": "next build --webpack",
    "start": "bun --bun next start -p ${PORT:-8100}",
    "start:dev": "ARGUS_ENV=dev PORT=8101 ARGUS_DB_PATH=./data/argus-dev.db bun run start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/",
    "e2e": "playwright test",
    "e2e:app": "playwright test --project=app --no-deps",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:seed": "bun run src/db/seed.ts",
    "plugin:sync": "bun run scripts/generate-plugin-registry.ts",
    "plugin:check": "bun run scripts/generate-plugin-registry.ts --check",
    "plugin:validate": "bun run scripts/validate-plugins.ts",
    "plugin:new": "bun run scripts/new-plugin.ts",
    "auth:access-key": "bun run scripts/access-key.ts",
    "start:container": "bun run scripts/container-start.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.2",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.44.0",
    "@lezer/highlight": "^1.2.5",
    "@microsoft/microsoft-graph-client": "3.0.7",
    "clsx": "2.1.1",
    "drizzle-orm": "0.36.4",
    "geist": "^1.7.2",
    "next": "16",
    "node-cron": "3.0.3",
    "react": "19",
    "react-dom": "19",
    "tailwind-merge": "2.5.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.49.0",
    "@types/bun": "latest",
    "@types/node": "22.9.0",
    "@types/node-cron": "3.0.11",
    "@types/react": "19",
    "@types/react-dom": "19",
    "autoprefixer": "10.4.20",
    "drizzle-kit": "0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.15",
    "typescript": "5.6.3"
  }
}
